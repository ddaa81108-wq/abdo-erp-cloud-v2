rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && (
          !('isActive' in userProfile())
          || userProfile().isActive == true
        )
        && userProfile().role != 'pending';
    }

    function isAdmin() {
      return isActiveUser() && userProfile().role == 'admin';
    }

    function hasPermission(permission) {
      return isAdmin()
        || (
          isActiveUser()
          && 'permissions' in userProfile()
          && permission in userProfile().permissions
          && userProfile().permissions[permission] == true
        );
    }

    function changesOnlySyncMetadata() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        '_syncRevision',
        '_updatedAt',
        '_changedChunks'
      ]);
    }

    function changesOnlyPurchaseSyncState() {
      return hasPermission('canViewPurchases')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          '_syncRevision',
          '_updatedAt',
          '_changedChunks',
          'purchaseLedgerMigrationVersion'
        ]);
    }

    function changesOnlyTreasurySyncState() {
      return hasPermission('canViewTreasury')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          '_syncRevision',
          '_updatedAt',
          '_changedChunks',
          'treasuryLedgerVersion'
        ]);
    }

    match /users/{userId} {
      // A signed-in user may read only their own profile so the application
      // can immediately detect deactivation or permission changes. Reading
      // any other profile still requires an active administrator.
      allow read: if (
        isSignedIn() && request.auth.uid == userId
      ) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // The shared metadata document is readable by active users. Employees
    // may update synchronization metadata only; business scalars remain
    // administrator-controlled.
    match /erp_system/main_state {
      allow read: if isActiveUser();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isActiveUser() && (
          changesOnlySyncMetadata()
          || changesOnlyPurchaseSyncState()
          || changesOnlyTreasurySyncState()
        ));
    }

    // Customer debts.
    match /erp_system/{documentId} {
      allow read, write: if documentId in [
        'chunk_customers',
        'chunk_cycles',
        'chunk_debt_transactions',
        'chunk_delegates'
      ] && hasPermission('canViewDebts');
    }

    // Companies and traders.
    match /erp_system/{documentId} {
      allow read, write: if documentId in [
        'chunk_companies',
        'chunk_company_transactions',
        'chunk_merchants',
        'chunk_merchant_transactions'
      ] && hasPermission('canViewCompanies');
    }

    match /erp_system/chunk_trust_deposits {
      allow read, write: if hasPermission('canViewDeposits');
    }

    match /erp_system/chunk_egyptian_cash_records {
      allow read, write: if hasPermission('canViewMailManual');
    }

    match /erp_system/{documentId} {
      allow read, write: if documentId in [
        'chunk_purchases',
        'chunk_purchase_accounts',
        'chunk_purchase_audit_log'
      ] && hasPermission('canViewPurchases');
    }

    match /erp_system/{documentId} {
      allow read, write: if documentId in [
        'chunk_treasury_transactions',
        'chunk_safe_audits'
      ] && hasPermission('canViewTreasury');
    }

    match /erp_system/{documentId} {
      allow read, write: if documentId in [
        'chunk_financial_report_rates',
        'chunk_financial_report_snapshots'
      ] && hasPermission('canViewFinancialReports');
    }

    match /erp_system/chunk_backup_points {
      allow read, write: if isAdmin();
    }

    match /erp_system/{backupDocument} {
      allow read, write: if backupDocument.matches('backup_.*')
        && isAdmin();
    }

    // User mirrors are administrative data. Login authority remains in the
    // top-level /users collection above.
    match /erp_system/chunk_users {
      allow read, write: if isAdmin();
    }

    // Shared reminders have no separate UI permission at present.
    match /erp_system/chunk_notes_and_reminders {
      allow read, write: if isActiveUser();
    }
  }
}
